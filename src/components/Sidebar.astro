---
// An array of navigation link objects. This makes it easy to add or remove links.
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const navLinks = [
  { href: `${base}/`, text: 'Home' },
  { href: `${base}/dropin-schedule`, text: 'Drop In Schedule' },
  { href: `${base}/clinic-schedule`, text: 'Clinic Schedule' },
  { href: `${base}/scoreboard`, text: 'Scoreboard' },
]

const currentPath = Astro.url.pathname

// Define classes for the link states, now permanently dark
const baseClasses =
  'block px-4 py-2.5 text-base transition-colors duration-200'
const inactiveClasses = 'text-mist-400 hover:bg-mist-800 hover:text-mist-100'
const activeClasses = 'bg-mist-700 text-mist-100'
---

<aside
  id="sidebar"
  class="fixed top-0 bottom-0 left-0 z-20 mt-16 h-screen w-56 -translate-x-full transform border-r border-(--color-line) bg-(--color-ink) text-mist-100 transition-transform duration-300 ease-in-out md:translate-x-0"
>
  <nav class="flex flex-col">
    {
      navLinks.map((link) => {
        const isActive =
          currentPath === link.href ||
          currentPath === link.href.replace(/\/$/, '')
        return (
          <a
            href={link.href}
            class:list={[
              baseClasses,
              isActive ? activeClasses : inactiveClasses,
            ]}
          >
            {link.text}
          </a>
        )
      })
    }
  </nav>
</aside>

<style is:global>
  body.menu-open #sidebar {
    --tw-translate-x: 0;
  }
</style>
